# Public feeds do not require a key for eligible non-commercial use.
# Review Open-Meteo terms and quotas before production/commercial deployment.
# Set these SERVER-SIDE through your hosting provider; never use NEXT_PUBLIC_.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Needed only for an independently scheduled service caller:
MONITOR_SECRET=
# Enable only while a Site is confirmed private behind platform authentication:
PRIVATE_SITE_MONITOR=false
